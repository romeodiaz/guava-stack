{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/load-hub.sh\" start",
            "timeout": 10,
            "statusMessage": "guava-stack: hub instructions"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/load-hub.sh\" context",
            "timeout": 10,
            "statusMessage": "guava-stack: hub context"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/load-hub.sh\" rules",
            "timeout": 10,
            "statusMessage": "guava-stack: hub rules"
          }
        ]
      }
    ]
  }
}
